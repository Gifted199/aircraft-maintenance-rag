# Copy to .env (git-ignored). Every setting the app reads is listed here; none holds a real secret.
#
# Lines that are commented out show the default used when the variable is not set.
# All settings are read by aero_rag.config.get_settings(); environment variables win over .env.

# ---------------------------------------------------------------------------------------------
# Secrets: NEVER put values here.
# They live in one AWS Secrets Manager secret (APP_SECRET_NAME below), a JSON object with:
#   AZURE_OPENAI_ENDPOINT   AZURE_OPENAI_API_KEY
#   OPENSEARCH_ENDPOINT     OPENSEARCH_USERNAME     OPENSEARCH_PASSWORD
#   LANGFUSE_PUBLIC_KEY     LANGFUSE_SECRET_KEY     LANGFUSE_HOST      (optional: tracing)
# Locally, the app reads the secret with boto3 using AWS_PROFILE (`aws sso login --profile aero`).
# On ECS, the task definition injects each key as an environment variable and AWS_PROFILE and
# APP_SECRET_NAME are not set, so the app never calls Secrets Manager.
# ---------------------------------------------------------------------------------------------

# --- AWS ---
AWS_REGION=eu-west-2
AWS_PROFILE=aero
APP_SECRET_NAME=akinsds1126-aero-rag/app
S3_BUCKET=akinsds1126-aero-rag-docs
# S3_PREFIX=manuals/

# --- OpenSearch (endpoint, username and password come from the secret) ---
OPENSEARCH_INDEX=aero-manuals
# OPENSEARCH_SEARCH_PIPELINE=aero-manuals-hybrid   # created by ingestion; holds the hybrid weights

# --- Azure OpenAI (endpoint and key come from the secret; names are your Azure deployments) ---
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# EMBEDDING_DIM=1536                  # must match the embedding model and the index mapping

# --- Guardrails and generation ---
# ABSTAIN_COSINE_THRESHOLD=0.35       # below this best similarity (and no exact id match): abstain
# MAX_QUESTION_CHARS=500              # input guardrail limit
# LLM_MAX_COMPLETION_TOKENS=4000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Langfuse tracing (optional; keys and host come from the secret) ---
# true sends the question and final answer text to Langfuse (redacted for secrets and hosts).
# The default in code is false. true is only for this synthetic demo data: it MUST be false
# for real, proprietary manuals.
LANGFUSE_CAPTURE_TEXT=true
# LANGFUSE_TIMEOUT_SECONDS=5
# ENVIRONMENT=dev                     # Langfuse environment label

# --- Scripts that call the API (scripts/, evaluation) ---
# API_URL=http://localhost:8000

# --- UI only (ui/presenter.py reads these from its own environment, not from this file) ---
# API_URL=http://localhost:8000       # compose: http://api:8000; ECS: http://localhost:8000
# API_TIMEOUT_SECONDS=120
