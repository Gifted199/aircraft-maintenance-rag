# Copy to .env. This file holds NON-SECRET settings only; .env is still git-ignored.
#
# Secrets are not kept on disk. They live in one AWS Secrets Manager secret (APP_SECRET_NAME),
# stored as JSON with these keys:
#   AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY,
#   OPENSEARCH_ENDPOINT, OPENSEARCH_USERNAME, OPENSEARCH_PASSWORD
# Locally the app reads the secret with boto3 using AWS_PROFILE (run `aws sso login --profile aero`).
# On ECS the task definition injects each key as an environment variable, and AWS_PROFILE is not set.

# --- AWS ---
AWS_REGION=eu-west-2
AWS_PROFILE=aero
APP_SECRET_NAME=akinsds1126-aero-rag/app
S3_BUCKET=akinsds1126-aero-rag-docs

# --- OpenSearch ---
OPENSEARCH_INDEX=aero-manuals

# --- Azure OpenAI (deployment names are what you called them in Azure) ---
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Optional (defaults shown) ---
# S3_PREFIX=manuals/
# EMBEDDING_DIM=1536
# LOG_LEVEL=INFO
# API_URL=http://localhost:8000
# LANGFUSE_HOST=https://cloud.langfuse.com
